{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "agent", "benchmark", "execution", "budget", "output"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "agent": {"type": "object", "additionalProperties": false, "required": ["manifest"], "properties": {"manifest": {"type": "string", "minLength": 1}, "config": {"type": "string", "minLength": 1}}},
    "benchmark": {"type": "object", "additionalProperties": false, "required": ["manifest", "prepared", "split"], "properties": {"manifest": {"type": "string", "minLength": 1}, "prepared": {"type": "string", "minLength": 1}, "split": {"type": "string", "minLength": 1}, "data_revision": {"type": "string", "minLength": 1}, "tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "scoring": {"type": "object"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["backend"], "properties": {"backend": {"enum": ["local", "docker"]}, "network": {"$ref": "#/$defs/network-policy"}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["wall_time_seconds"], "properties": {"wall_time_seconds": {"type": "number", "exclusiveMinimum": 0}, "model_calls": {"type": "integer", "minimum": 0}, "tokens": {"type": "integer", "minimum": 0}, "tool_calls": {"type": "integer", "minimum": 0}}},
    "budget_policy": {"enum": ["strict", "best_effort"]},
    "seed": {"type": "integer"}, "output": {"type": "string", "minLength": 1}, "extensions": {"type": "object"}
  },
  "$defs": {
    "mode": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["internet", "none"]}}},
    "network-policy": {"type": "object", "additionalProperties": false, "properties": {"agent": {"$ref": "#/$defs/mode"}, "sandbox": {"$ref": "#/$defs/mode"}}}
  }
}
