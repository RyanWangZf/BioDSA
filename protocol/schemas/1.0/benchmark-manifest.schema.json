{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["manifest_version", "benchmark_id", "version", "protocol_versions", "task_types", "prepare", "evaluate", "schemas", "aggregation"],
  "properties": {
    "manifest_version": {"const": "1.0"}, "benchmark_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1}, "description": {"type": "string"},
    "protocol_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "task_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "prepare": {"$ref": "#/$defs/process"}, "evaluate": {"$ref": "#/$defs/process"},
    "evaluator": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "schemas": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["input", "output"], "properties": {"input": {"type": "string", "minLength": 1}, "output": {"type": "string", "minLength": 1}}}},
    "metrics": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "properties": {"description": {"type": "string"}}}},
    "aggregation": {"type": "object", "additionalProperties": {"oneOf": [
      {"enum": ["mean", "sum", "min", "max", "count"]},
      {"type": "object", "additionalProperties": false, "required": ["operation", "agent_failure"], "properties": {"operation": {"enum": ["mean", "sum", "min", "max", "count"]}, "agent_failure": {"enum": ["exclude", "zero"]}}}
    ]}},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "process": {"type": "object", "additionalProperties": false, "required": ["command", "runtime"], "properties": {"command": {"$ref": "#/$defs/argv"}, "runtime": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["local", "docker"]}}}, "required_env": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}
  }
}
