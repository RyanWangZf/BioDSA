{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "benchmark_id", "benchmark_version", "data_revision", "task_types"],
  "properties": {
    "protocol_version": {"const": "1.0"}, "benchmark_id": {"type": "string", "minLength": 1},
    "benchmark_version": {"type": "string", "minLength": 1}, "data_revision": {"type": "string", "minLength": 1},
    "split": {"type": "string", "minLength": 1}, "tasks_file": {"type": "string", "minLength": 1},
    "splits": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["tasks_file"], "properties": {"tasks_file": {"type": "string", "minLength": 1}}}},
    "checksum": {"type": "string"}, "task_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "assets_dir": {"type": "string", "minLength": 1},
    "private": {"type": "object", "additionalProperties": false, "properties": {"references": {"type": "string", "minLength": 1}, "reference_version": {"type": "string", "minLength": 1}}},
    "extensions": {"type": "object"}
  },
  "oneOf": [
    {"required": ["split", "tasks_file"], "not": {"required": ["splits"]}},
    {"required": ["splits"], "not": {"anyOf": [{"required": ["split"]}, {"required": ["tasks_file"]}]}}
  ]
}
