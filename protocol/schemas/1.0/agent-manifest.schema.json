{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "agent_id", "protocol_versions", "task_types", "local"],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "agent_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "protocol_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "task_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "local": {"$ref": "#/$defs/command"},
    "docker": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "command"],
      "properties": {
        "build_context": {"type": "string", "minLength": 1},
        "dockerfile": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "digest": {"type": ["string", "null"]},
        "command": {"$ref": "#/$defs/argv"}
      }
    },
    "required_env": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"}},
    "network": {"$ref": "#/$defs/network-policy"},
    "sandbox": {
      "type": "object", "additionalProperties": false,
      "required": ["docker"],
      "properties": {
        "docker": {"$ref": "#/$defs/docker-runtime"},
        "resources": {"$ref": "#/$defs/resources"},
        "required_env": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"}}
      }
    },
    "resources": {"$ref": "#/$defs/resources"},
    "budget_capabilities": {
      "oneOf": [
        {"type": "array", "uniqueItems": true, "items": {"enum": ["model_calls", "tokens", "tool_calls"]}},
        {"type": "object", "additionalProperties": false, "properties": {
          "model_calls": {"enum": ["agent_enforced", "reported_only"]},
          "tokens": {"enum": ["agent_enforced", "reported_only"]},
          "tool_calls": {"enum": ["agent_enforced", "reported_only"]}
        }}
      ]
    },
    "extensions": {"type": "object"}
  },
  "$defs": {
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "command": {"type": "object", "additionalProperties": false, "required": ["command"], "properties": {"command": {"$ref": "#/$defs/argv"}}},
    "mode": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["internet", "none"]}}},
    "network-policy": {"type": "object", "additionalProperties": false, "properties": {"agent": {"$ref": "#/$defs/mode"}, "sandbox": {"$ref": "#/$defs/mode"}}},
    "docker-runtime": {"type": "object", "additionalProperties": false, "required": ["image", "command"], "properties": {"build_context": {"type": "string", "minLength": 1}, "dockerfile": {"type": "string", "minLength": 1}, "image": {"type": "string", "minLength": 1}, "command": {"$ref": "#/$defs/argv"}}},
    "resources": {"type": "object", "additionalProperties": false, "properties": {"cpus": {"type": "number", "exclusiveMinimum": 0}, "memory": {"type": "string", "minLength": 1}, "gpus": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "minLength": 1}]}}}
  }
}
