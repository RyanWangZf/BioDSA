{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["user_task", "tables", "output_requirements"],
  "properties": {
    "user_task": {"type": "string", "minLength": 1},
    "tables": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["asset_id", "description"], "properties": {"asset_id": {"type": "string"}, "description": {"type": "string"}, "columns": {"type": "array", "items": {"type": "string"}}}}},
    "output_requirements": {"type": "array", "items": {"type": "string"}}
  }
}
